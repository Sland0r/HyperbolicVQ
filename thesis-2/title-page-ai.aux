\@writefile{toc}{\contentsline {paragraph}{The gradient flow.}{33}{section*.36}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {B.1}{\ignorespaces Forward pass of the hyperbolic Residual Quantized Variational Autoencoders. The encoder $E$ produces a tangent vector that is mapped onto the Poincar\'e ball by $\qopname  \relax o{exp}_0^c$ to give the encoder point $z_e$ (the initial residual $r_0$). Inside the residual quantization module (RQM), each stage quantizes the current residual $r_{i-1}$ to a code $q_i$ and forms the next residual by M\"obius subtraction; the codes are recomposed by the aggregation operator (Agg, function of the chosen codes) into $\hat  z$, which is mapped back to the tangent space by $\qopname  \relax o{log}_0^c$ and decoded by $G$. It is possible to reconstruct the gradient flow by following the arrows in reverse: the reconstruction gradient starts from the decoder and the commitment gradient is injected from each residual.}}{34}{figure.B.1}\protected@file@percent }
\newlabel{fig:rqvae_schematic}{{B.1}{34}{Forward pass of the hyperbolic Residual Quantized Variational Autoencoders. The encoder $E$ produces a tangent vector that is mapped onto the Poincar\'e ball by $\exp _0^c$ to give the encoder point $z_e$ (the initial residual $r_0$). Inside the residual quantization module (RQM), each stage quantizes the current residual $r_{i-1}$ to a code $q_i$ and forms the next residual by M\"obius subtraction; the codes are recomposed by the aggregation operator (Agg, function of the chosen codes) into $\hat z$, which is mapped back to the tangent space by $\log _0^c$ and decoded by $G$. It is possible to reconstruct the gradient flow by following the arrows in reverse: the reconstruction gradient starts from the decoder and the commitment gradient is injected from each residual}{figure.B.1}{}}
\newlabel{fig:rqvae_schematic@cref}{{[figure][1][2147483647,2]B.1}{[1][33][]34}}
